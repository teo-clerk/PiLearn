# ─────────────────────────────────────────────────────────────────────────────
# PiLearn — environment template
#
#   cp .env.example .env      then fill in the real values.
#   .env is gitignored. Never commit a filled-in copy.
#
# Every key marked REQUIRED must be set or the backend refuses to start
# (fail-fast validation in JwtProperties / StorageProperties).
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring profile ───────────────────────────────────────────────────────────
# local  → local Postgres + MinIO via docker compose
# gcloud → Cloud SQL + Cloud Run + R2
SPRING_PROFILES_ACTIVE=local

# ── Security: JWT ────────────────────────────────────────────────────────────
# REQUIRED. HMAC-512 signing key. Minimum 64 characters.
# Generate one:  openssl rand -base64 64 | tr -d '\n'
# Rotating this invalidates every issued token.
JWT_SECRET=

# Token lifetime in milliseconds. 86400000 = 24h.
JWT_EXPIRATION_MS=86400000

# ── Database ─────────────────────────────────────────────────────────────────
# Matches the docker compose service below by default.
DB_URL=jdbc:postgresql://localhost:5432/pianoml
DB_USERNAME=pilearn
DB_PASSWORD=                       # REQUIRED (compose reads the same value)
DB_POOL_MAX_SIZE=10

# ── Object storage (S3-compatible: MinIO locally, Cloudflare R2 in prod) ─────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pilearn-media
STORAGE_ACCESS_KEY=                # REQUIRED
STORAGE_SECRET_KEY=                # REQUIRED
STORAGE_PATH_STYLE_ACCESS=true     # true for MinIO, false for R2

# ── OMR worker (FastAPI service — arrives in Phase 2) ────────────────────────
# Until Phase 2 lands, ingestion still runs through the legacy Cloud Run job path.
OMR_WORKER_URL=http://localhost:8000
OMR_WORKER_TOKEN=                  # shared secret for backend → worker calls
OMR_DEFAULT_ENGINE=homr            # homr | audiveris | arbiter
OMR_CONFIDENCE_THRESHOLD=0.60      # below this → REVIEW_REQUIRED

# ── Google Cloud (only needed with SPRING_PROFILES_ACTIVE=gcloud) ────────────
GCLOUD_PROJECT_ID=
GCLOUD_LOCATION=us-central1
GCLOUD_RUN_JOB_NAME=pilearn-workload
# Path to a service-account JSON key. Prefer Application Default Credentials
# (workload identity) and leave this empty in managed environments.
GOOGLE_APPLICATION_CREDENTIALS=

# ── External APIs (optional — features degrade gracefully when unset) ────────
# YouTube Data API v3 key, for reference-performance lookup on score pages.
YOUTUBE_API_KEY=
# MusicBrainz requires a descriptive UA with contact info per their policy.
MUSICBRAINZ_USER_AGENT=PiLearn/3.0 ( you@example.com )

# ── Frontend (build-time) ────────────────────────────────────────────────────
# Base URL the Angular client targets. The dev proxy rewrites /api → BASE_PATH.
BASE_PATH=http://localhost:8080
